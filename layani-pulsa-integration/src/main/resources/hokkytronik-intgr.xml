<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:int="http://www.springframework.org/schema/integration"
       xmlns:int-http="http://www.springframework.org/schema/integration/http"
       xsi:schemaLocation="http://www.springframework.org/schema/integration http://www.springframework.org/schema/integration/spring-integration.xsd
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/integration/http http://www.springframework.org/schema/integration/http/spring-integration-http.xsd">

    <int:channel id="hokkytronik_in"/>
    <int:channel id="hokkytronik_out"/>
    <int:channel id="check_post_paid"/>
    <int-http:inbound-channel-adapter
            channel="hokkytronik_in" status-code-expression="T(org.springframework.http.HttpStatus).OK"
            supported-methods="POST" path="/hokkytronik/callback"
            >
        <!--request-payload-type="org.slerp.core.Domain"-->
    </int-http:inbound-channel-adapter>
    <int:service-activator input-channel="hokkytronik_in" ref="hokkytronikHttpReceiver" method="execute" output-channel="hokkytronik_out"/>
    <int:router input-channel="hokkytronik_out" expression="payload.status">
        <int:mapping value="S" channel="transaction_success"/>
        <int:mapping value="I" channel="nullChannel"/>
        <int:mapping value="F" channel="refund_deposit_outlet"/>
        <int:mapping value="C" channel="check_post_paid"/>
    </int:router>
    <int:service-activator input-channel="check_post_paid" ref="transactionCheckPostPaidActivator" method="execute" output-channel="notification_in"/>
</beans>
